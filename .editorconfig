# Top-most EditorConfig file
root = true

# Global settings
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# Java files
[*.java]
indent_style = space
indent_size = 4
tab_width = 4
# Ensure spaces around operators and after commas
space_around_operators = true
space_after_comma = true
# Note: .editorconfig does not support brace_style directly.
# To enforce same-line braces for if statements (e.g., if (condition) { on one line),
# use a formatter like Prettier or configure in VS Code/Java extension settings.

# Markdown files
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true
max_line_length = off

# Python files
[*.py]
indent_style = space
indent_size = 4
tab_width = 4

# JSON files
[*.json]
indent_style = space
indent_size = 2
tab_width = 2

# YAML files
[*.yml]
indent_style = space
indent_size = 2
tab_width = 2

# XML files
[*.xml]
indent_style = space
indent_size = 2
tab_width = 2

# Shell scripts
[*.sh]
end_of_line = lf
insert_final_newline = true

# Ignore minified files
[*.min.js]
max_line_length = off
trim_trailing_whitespace = false

# C/C++ files
[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 4
tab_width = 4

# HTML files
[*.html]
indent_style = space
indent_size = 2
tab_width = 2

# CSS files
[*.css]
indent_style = space
indent_size = 2
tab_width = 2
