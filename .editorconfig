root = true

# Strict baseline style for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

# Java style (4 spaces, 100-column target)
[*.java]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 100

[package-info.java]
indent_style = space
indent_size = 4

[module-info.java]
indent_style = space
indent_size = 4

# Markdown keeps meaningful trailing spaces
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Config and data files use 2-space indentation
[*.{json,yml,yaml,xml,html,css,scss}]
indent_style = space
indent_size = 2
tab_width = 2

# Shell scripts
[*.sh]
end_of_line = lf
insert_final_newline = true

# Minified files are not reformatted
[*.min.js]
max_line_length = off
trim_trailing_whitespace = false
